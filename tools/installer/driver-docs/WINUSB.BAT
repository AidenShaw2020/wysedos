@ECHO OFF
C:
CD \
C:\DRIVERS\USBDOS\USBDRIVE.COM U
IF ERRORLEVEL 4 GOTO FAIL
IF ERRORLEVEL 3 GOTO HOST
IF ERRORLEVEL 1 GOTO FAIL
:HOST
C:\DRIVERS\USBDOS\USBUHCIL.COM U
IF ERRORLEVEL 16 GOTO FAIL
IF ERRORLEVEL 15 GOTO WIN
IF ERRORLEVEL 1 GOTO FAIL
:WIN
C:\WINDOWS\WIN.COM
GOTO END
:FAIL
ECHO Windows was not started because a DOS USB driver is still active.
ECHO Close USB programs and retry.
:END
